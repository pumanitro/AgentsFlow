{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["renderer/*"]
    }
  },
  "include": ["renderer/**/*.ts", "renderer/**/*.tsx", "shared/**/*.ts"],
  "exclude": ["node_modules", "electron", "dist", "renderer/out"]
}
